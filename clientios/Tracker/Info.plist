<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- L'app est verrouillée en mode sombre : force toute la collection de traits
	     (SwiftUI + UIKit) en sombre, quel que soit le réglage système. Sans ça, en
	     mode clair le texte des contrôles UIKit (listes, menus, feuilles) restait
	     sombre sur nos fonds sombres. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- Autorise les connexions HTTP en réseau local (backend Tracker sur localhost). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Permission requise pour enregistrer une affiche dans la photothèque. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Autorise l'enregistrement des affiches de films et séries dans votre photothèque.</string>
</dict>
</plist>
